main.main-content
  .container
    // 1. HERO СЕКЦІЯ
    section.hero-section
      .hero-left
        .today-badge
          span.dot
          | Сьогодні вільно 9 прийомів
        h1.hero-title Запис до лікаря за 1 хвилину — без черг та очікувань
        p.hero-desc Оберіть спеціаліста, зручний час і підтвердіть запис онлайн. Талон прийде одразу, а на прийом ви потрапите точно в призначений час.
        .hero-actions
          a.btn-primary(href="#booking") Записатися на прийом
          a.btn-secondary(href="#doctors") Обрати лікаря

      .hero-right
        .quick-slots-card
          h3 Найближчі вільні слоти
          .slot-row
            .doc-info
              strong Терапевт
              span Коваленко О. М.
            span.badge-time сьогодні, 14:30
          .slot-row
            .doc-info
              strong Кардіолог
              span Мельник А. В.
            span.badge-time завтра, 09:00
          .slot-row
            .doc-info
              strong Невролог
              span Шевченко І. П.
            span.badge-time завтра, 11:30
          p.quick-note Розклад оновлюється в реальному часі

    // 2. СЕКЦІЯ ЛІКАРІВ (6 спеціалістів)
    section.doctors-section#doctors
      h2 Наші спеціалісти
      p.subtitle Оберіть лікаря — ми підставимо його у форму запису.
      .doctors-slider
        button.slider-arrow(type="button") ‹
        .doctors-grid
          .doctor-card
            .doc-header
              .avatar-circle.teal КО
              .doc-meta
                h4 Коваленко Олена Миколаївна
                span.spec Терапевт
            .doc-details
              .detail-row
                span Досвід роботи
                strong 12 років
              .detail-row
                span Первинний прийом
                strong 600 грн
            button.btn-select(type="button" onclick="selectDoctorByIndex(0)") Обрати спеціаліста

          .doctor-card
            .doc-header
              .avatar-circle.blue МА
              .doc-meta
                h4 Мельник Андрій Віталійович
                span.spec Кардіолог
            .doc-details
              .detail-row
                span Досвід роботи
                strong 15 років
              .detail-row
                span Первинний прийом
                strong 900 грн
            button.btn-select(type="button" onclick="selectDoctorByIndex(1)") Обрати спеціаліста

          .doctor-card
            .doc-header
              .avatar-circle.dark-blue ШІ
              .doc-meta
                h4 Шевченко Ірина Петрівна
                span.spec Невролог
            .doc-details
              .detail-row
                span Досвід роботи
                strong 9 років
              .detail-row
                span Первинний прийом
                strong 750 грн
            button.btn-select(type="button" onclick="selectDoctorByIndex(2)") Обрати спеціаліста

          .doctor-card
            .doc-header
              .avatar-circle.blue БВ
              .doc-meta
                h4 Бондаренко Василь Іванович
                span.spec Офтальмолог
            .doc-details
              .detail-row
                span Досвід роботи
                strong 14 років
              .detail-row
                span Первинний прийом
                strong 700 грн
            button.btn-select(type="button" onclick="selectDoctorByIndex(3)") Обрати спеціаліста

          .doctor-card
            .doc-header
              .avatar-circle.teal КН
              .doc-meta
                h4 Кравченко Наталія Сергіївна
                span.spec Ендокринолог
            .doc-details
              .detail-row
                span Досвід роботи
                strong 11 років
              .detail-row
                span Первинний прийом
                strong 850 грн
            button.btn-select(type="button" onclick="selectDoctorByIndex(4)") Обрати спеціаліста

          .doctor-card
            .doc-header
              .avatar-circle.dark-blue ТМ
              .doc-meta
                h4 Ткаченко Михайло Юрійович
                span.spec Хірург
            .doc-details
              .detail-row
                span Досвід роботи
                strong 18 років
              .detail-row
                span Первинний прийом
                strong 950 грн
            button.btn-select(type="button" onclick="selectDoctorByIndex(5)") Обрати спеціаліста
        button.slider-arrow(type="button") ›

    // 3. ФОРМА ОНЛАЙН-ЗАПИСУ
    section.booking-section#booking
      .booking-card
        .booking-left
          h3.step-title 1. Оберіть дату (жовтень-листопад 2026 р.)
          .calendar-box
            .weekdays-row
              span Пн
              span Вт
              span Ср
              span Чт
              span Пт
              span Сб
              span Нд
            .days-grid
              // 1-й тиждень
              label.day-cell.today
                input(type="radio" name="booking-day" checked)
                span 16
              label.day-cell
                input(type="radio" name="booking-day")
                span 17
              label.day-cell
                input(type="radio" name="booking-day")
                span 18
              label.day-cell
                input(type="radio" name="booking-day")
                span 19
              label.day-cell
                input(type="radio" name="booking-day")
                span 20
              label.day-cell
                input(type="radio" name="booking-day")
                span 21
              label.day-cell
                input(type="radio" name="booking-day")
                span 22

              // 2-й тиждень
              label.day-cell
                input(type="radio" name="booking-day")
                span 23
              label.day-cell
                input(type="radio" name="booking-day")
                span 24
              label.day-cell
                input(type="radio" name="booking-day")
                span 25
              label.day-cell
                input(type="radio" name="booking-day")
                span 26
              label.day-cell
                input(type="radio" name="booking-day")
                span 27
              label.day-cell
                input(type="radio" name="booking-day")
                span 28
              label.day-cell
                input(type="radio" name="booking-day")
                span 29

              // 3-й тиждень
              label.day-cell
                input(type="radio" name="booking-day")
                span 30
              label.day-cell
                input(type="radio" name="booking-day")
                span 31
              label.day-cell
                input(type="radio" name="booking-day")
                span 1
              label.day-cell
                input(type="radio" name="booking-day")
                span 2
              label.day-cell
                input(type="radio" name="booking-day")
                span 3
              label.day-cell
                input(type="radio" name="booking-day")
                span 4
              label.day-cell
                input(type="radio" name="booking-day")
                span 5

          h3.step-title 2. Оберіть час (зміна 09:00 - 14:00)
          .slots-grid
            // Слоти рендеряться динамічно скриптом з doctors.json залежно від дати
          p.hint Перекреслені години вже зайняті іншими пацієнтами.

        .booking-right
          .form-box
            h3.form-heading 3. Ваші дані
            .field-group
              label ОБРАНИЙ СПЕЦІАЛІСТ
              select#doc-select
                option(value="") Завантаження списку спеціалістів...

            .field-group
              label ТИП КОНСУЛЬТАЦІЇ
              .two-cols
                label.pill-radio
                  input(type="radio" name="consultation-type" value="primary" checked)
                  span.text-label Первинний
                label.pill-radio
                  input(type="radio" name="consultation-type" value="secondary")
                  span.text-label Повторний
                  span.badge-discount -25%

            .field-group
              label КОНТАКТНІ ДАНІ ПАЦІЄНТА
              input#patient-name(type="text" placeholder="Введіть ПІБ (наприклад, Коваленко Олена)" required)
              span.error-msg#name-error
              input#patient-phone(type="tel" placeholder="+380 (XX) XXX-XX-XX" style="margin-top: 8px;" required)
              span.error-msg#phone-error

            .field-group
              label СПОСІБ ОПЛАТИ
              .two-cols
                label.pill-radio
                  input(type="radio" name="payment-method" value="reception" checked)
                  span.text-label На рецепції
                label.pill-radio
                  input(type="radio" name="payment-method" value="online")
                  span.text-label Онлайн-картка

            .price-row
              span До сплати:
              strong#total-price 600 грн

            button.submit-btn(type="button") Підтвердити запис

    // МОДАЛЬНЕ ВІКНО: ЕЛЕКТРОННИЙ ТАЛОН
    .ticket-modal-overlay#ticket-modal
      .ticket-modal-card
        .ticket-modal-header
          .check-badge ✓
          h3 Запис успішно підтверджено!
          p.ticket-num#modal-ticket-id Талон №MS-2026-0000
        
        .ticket-details
          .ticket-row
            span Пацієнт:
            strong#modal-patient-name -
          .ticket-row
            span Телефон:
            strong#modal-patient-phone -
          .ticket-row
            span Спеціаліст:
            strong#modal-doctor-name -
          .ticket-row
            span Дата прийому:
            strong#modal-date -
          .ticket-row
            span Час візиту:
            strong#modal-time -
          .ticket-row
            span Тип консультації:
            strong#modal-type -
          .ticket-row
            span Спосіб оплати:
            strong#modal-payment -
          .ticket-row.total
            span До сплати:
            strong#modal-total-price 0 грн
        
        p.ticket-note Збережіть номер талона або покажіть його на рецепції перед прийомом.
        button.btn-modal-close(type="button" onclick="closeTicketModal()") Зрозуміло, закрити